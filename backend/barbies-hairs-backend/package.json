{
  "name": "barbies-hairs-backend",
  "version": "1.0.0",
  "description": "Barbie's Hairs e-shop for all hairs related",
  "main": "app.js",
  "scripts": {
    "dev": "concurrently \"tsc --watch\" \"nodemon --watch dist dist/server.js\"",
    "start:prod": "NODE_ENV=production nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "npm run build && node dist/seeder.js",
    "seeder": "npm run build && node dist/src/categorySeeder.js",
    "seeder:destory": "npm run build && node dist/src/categorySeeder.js",
    "seed:destroy": "npm run build && node dist/seeder.js -d"
  },
  "keywords": [],
  "author": "promise sylva",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/cookie-parser": "^1.4.9",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.15.0",
    "sharp": "^0.34.3",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.19",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.15.2",
    "concurrently": "^9.2.1",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "npm": "^11.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
